# Runtime artifacts the playbook generates inside the materialized workspace —
# never committed to the pack source.
**/.roksbnkctl-home/
**/seed-config.yaml
**/outputs.json
**/.bnk_ansible_vars_*

# Demo recorder: deps, renders, captured frames, and the runner's saved answers.
demo/node_modules/
demo/out/
demo/answers.json

# OpenTofu/Terraform working state for the modules in this repo. `terraform init`
# downloads ~150 MB of providers into .terraform/ — GitHub rejects the push above
# 100 MB, and the Forge opentofu engine runs its own init anyway.
**/.terraform/
**/.terraform.lock.hcl
**/terraform.tfstate
**/terraform.tfstate.backup
**/*.tfvars
!**/*.tfvars.example

# demo runtime — never commit credentials or run state
scripts/demo/.env
scripts/demo/.demo-state/
# Each variant gets its own state dir when they run concurrently
# (STATE=… E2E_WS=…), so the suffixed forms have to be ignored too.
scripts/e2e/.e2e-state/
scripts/e2e/.e2e-state-*/
scripts/e2e/logs/
