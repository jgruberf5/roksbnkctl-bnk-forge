# disconnected-roks-cluster demo — copy to .env, fill in, `set -a; source .env; set +a`.
# Anything left unset is prompted for interactively; secrets are never echoed.

# ── BNK Forge ────────────────────────────────────────────────────────────────
FORGE_URL=https://forge.example.com
FORGE_USER=admin
# FORGE_PASSWORD is prompted for if unset — prefer that over putting it here.
#FORGE_PASSWORD=
# Skip TLS verification when talking to a Forge with a self-signed cert.
FORGE_INSECURE=1

# The IBM Cloud credential template on the Forge that the deployments use.
# Find its id under Access Methods → Credential Templates. Its API key must be
# for the account that holds the cluster, the VPCs and the COS bucket below.
FORGE_CREDENTIAL_TEMPLATE_ID=

# ── IBM Cloud ────────────────────────────────────────────────────────────────
REGION=us-east
ZONE=us-east-1
RESOURCE_GROUP=default
# Prefix for the IBM resources this demo creates (VPC, subnets, Harbor VSI,
# floating IPs). Short and DNS-safe; it is NOT the cluster name.
PREFIX=f5demo

# An EXISTING ROKS cluster with BNK not installed. The demo adopts it; it is
# never created and never destroyed. Independent of PREFIX.
CLUSTER_NAME=fdisco
# Its registry COS instance. Blank lets `cluster register` probe
# <prefix>-registry-cos / <cluster>-registry-cos / <cluster>-cos.
REGISTRY_COS_NAME=

# An EXISTING Transit Gateway. The services VPC and the cluster VPC both attach
# to it, so the air-gapped cluster reaches the mirror and the proxy privately.
TRANSIT_GATEWAY=bnkci-testing

# An EXISTING IBM Cloud VPC SSH key, and the matching private key on this host.
# The demo SSHes to Harbor to read its CA, and jumps through it to the FLP.
SSH_KEY_NAME=forge-e2e-key
SSH_KEY_FILE=~/.ssh/forge_e2e_key

# ── services network ─────────────────────────────────────────────────────────
# MUST NOT overlap the cluster VPC. roksbnkctl fixes cluster subnets at
# 10.241.0.0/24, 10.241.64.0/24 and 10.241.128.0/24, so keep clear of 10.241/16.
SERVICES_SUBNET_CIDR=10.243.0.0/24
# A second prefix appliances allocate their own subnets from (the FLP does).
SERVICES_SPARE_CIDR=10.243.1.0/24

# ── Harbor ───────────────────────────────────────────────────────────────────
#HARBOR_ADMIN_PASSWORD=          # prompted for if unset
HARBOR_PROJECT=bnk-mirror

# ── the BNK supply chain ─────────────────────────────────────────────────────
# COS holding the FAR auth tarball + subscription JWT. `roksbnkctl init` names
# the bucket with a per-account suffix, so it usually is NOT the bare default.
COS_INSTANCE=bnk-supply-chain
COS_BUCKET=bnk-artifacts-0b5a00334eaf
COS_REGION=us-south
FAR_AUTH_FILE=f5-far-auth-key.tgz
SUBSCRIPTION_JWT_FILE=subscription.jwt
MANIFEST_VERSION=2.3.0-3.2598.3-0.0.170

# ── Forge project names ──────────────────────────────────────────────────────
# What the projects are called in the BNK Forge UI. Separate from PREFIX, which
# names IBM resources: these are labels a human reads, so they say what they are.
PROJECT_HARBOR=f5demo-harbor-registry
PROJECT_FLP=f5demo-roksbnkctl-flp
PROJECT_DISCO=f5demo-roksbnkctl-disconnected-cluster

# The Forge project the adopted cluster is REGISTERED into — the one whose
# Kubernetes page you watch while BNK installs onto the cluster. Leave it blank
# and roksbnkctl creates one literally named "bnk".
BNKFORGE_PROJECT=f5demo-roksbnkctl-existing-cluster

# ── behaviour ────────────────────────────────────────────────────────────────
# The script takes one argument:
#   up    (default) deploy Harbor + FAR mirror, the FLP, then register + install
#   down  destroy all of it and delete the Forge projects; the module source,
#         the modules and the blueprint releases are left in place
AUTO_ADVANCE=1     # 0 pauses between phases
