{
  "schema_version": 1,
  "name": "roksbnkctl-cluster-create",
  "version": "5.10.0",
  "kind": "container_image",
  "description": "Create a ROKS cluster, its VPC and its Transit Gateway with roksbnkctl, then register it with BNK Forge.",
  "container_image": {
    "registry_host": "ghcr.io",
    "repository": "jgruberf5/roksbnkctl-tools-runner",
    "digest": "sha256:bfd395b24191d1ad445323b98f4447f2fb52a4662de2358af2c64fddd0c8ea6b"
  },
  "lifecycle": {
    "supports_apply": true,
    "supports_destroy": true
  },
  "credentials": {
    "cloud": "ibmcloud"
  },
  "state": {
    "mount_path": "/work",
    "outputs_file": ".roksbnkctl/bnk/cluster-outputs.json",
    "home_env": {
      "HOME": "/home/runner",
      "ROKSBNKCTL_HOME": "/work/.roksbnkctl"
    },
    "scope": "deployment"
  },
  "execution": {
    "engine": "container",
    "limits": {
      "cpus": "2",
      "memory": "2g"
    }
  },
  "steps": {
    "apply": [
      {
        "name": "init",
        "env": {
          "HOME": "/home/runner",
          "ROKSBNKCTL_PREFIX": "{{inputs.prefix}}",
          "ROKSBNKCTL_REGION": "{{inputs.region}}",
          "ROKSBNKCTL_RESOURCE_GROUP": "{{inputs.resource_group}}",
          "ROKSBNKCTL_CLUSTER_CREATE": "true",
          "ROKSBNKCTL_OPENSHIFT_VERSION": "{{inputs.openshift_version}}",
          "ROKSBNKCTL_WORKERS_PER_ZONE": "{{inputs.workers_per_zone}}",
          "ROKSBNKCTL_CLUSTER_PUBLIC_GATEWAY": "{{inputs.public_gateway}}",
          "ROKSBNKCTL_TRANSIT_GATEWAY_NAME": "{{inputs.existing_transit_gateway}}",
          "IBMCLOUD_API_KEY": "{{inputs.ibmcloud_api_key}}",
          "ROKSBNKCTL_CLUSTER_VPC_CIDR": "{{inputs.cluster_vpc_cidr}}",
          "ROKSBNKCTL_CLUSTER_VPC_ID": "{{inputs.cluster_vpc_id}}",
          "ROKSBNKCTL_EXISTING_SUBNET_IDS": "{{inputs.existing_subnet_ids}}"
        },
        "args": [
          "roksbnkctl",
          "init",
          "-w",
          "bnk",
          "--override-from-env",
          "--non-interactive"
        ],
        "timeout_seconds": 300
      },
      {
        "name": "cluster-up",
        "env": {
          "HOME": "/home/runner",
          "ROKSBNKCTL_PREFIX": "{{inputs.prefix}}",
          "ROKSBNKCTL_REGION": "{{inputs.region}}",
          "ROKSBNKCTL_RESOURCE_GROUP": "{{inputs.resource_group}}",
          "ROKSBNKCTL_CLUSTER_CREATE": "true",
          "ROKSBNKCTL_OPENSHIFT_VERSION": "{{inputs.openshift_version}}",
          "ROKSBNKCTL_WORKERS_PER_ZONE": "{{inputs.workers_per_zone}}",
          "ROKSBNKCTL_CLUSTER_PUBLIC_GATEWAY": "{{inputs.public_gateway}}",
          "IBMCLOUD_API_KEY": "{{inputs.ibmcloud_api_key}}"
        },
        "args": [
          "roksbnkctl",
          "-w",
          "bnk",
          "cluster",
          "up",
          "--auto"
        ],
        "timeout_seconds": 5400
      },
      {
        "name": "bnkforge-register",
        "when": "{{inputs.bnkforge_url}}",
        "env": {
          "HOME": "/home/runner",
          "ROKSBNKCTL_PREFIX": "{{inputs.prefix}}",
          "ROKSBNKCTL_REGION": "{{inputs.region}}",
          "ROKSBNKCTL_RESOURCE_GROUP": "{{inputs.resource_group}}",
          "ROKSBNKCTL_CLUSTER_CREATE": "true",
          "ROKSBNKCTL_OPENSHIFT_VERSION": "{{inputs.openshift_version}}",
          "ROKSBNKCTL_WORKERS_PER_ZONE": "{{inputs.workers_per_zone}}",
          "ROKSBNKCTL_CLUSTER_PUBLIC_GATEWAY": "{{inputs.public_gateway}}",
          "BNK_FORGE_URL": "{{inputs.bnkforge_url}}",
          "BNK_FORGE_USER": "{{inputs.bnkforge_username}}",
          "BNK_FORGE_PASSWORD": "{{inputs.bnkforge_password}}",
          "KUBECONFIG": "/work/.kube/config",
          "IBMCLOUD_API_KEY": "{{inputs.ibmcloud_api_key}}"
        },
        "args": [
          "roksbnkctl",
          "-w",
          "bnk",
          "bnkforge",
          "register",
          "--project",
          "{{inputs.bnkforge_project}}",
          "--insecure={{inputs.bnkforge_insecure}}"
        ],
        "timeout_seconds": 600
      }
    ],
    "destroy": [
      {
        "name": "init-restore",
        "env": {
          "HOME": "/home/runner",
          "ROKSBNKCTL_PREFIX": "{{inputs.prefix}}",
          "ROKSBNKCTL_REGION": "{{inputs.region}}",
          "ROKSBNKCTL_RESOURCE_GROUP": "{{inputs.resource_group}}",
          "ROKSBNKCTL_CLUSTER_CREATE": "true",
          "ROKSBNKCTL_OPENSHIFT_VERSION": "{{inputs.openshift_version}}",
          "ROKSBNKCTL_WORKERS_PER_ZONE": "{{inputs.workers_per_zone}}",
          "ROKSBNKCTL_CLUSTER_PUBLIC_GATEWAY": "{{inputs.public_gateway}}",
          "ROKSBNKCTL_TRANSIT_GATEWAY_NAME": "{{inputs.existing_transit_gateway}}",
          "IBMCLOUD_API_KEY": "{{inputs.ibmcloud_api_key}}",
          "ROKSBNKCTL_CLUSTER_VPC_CIDR": "{{inputs.cluster_vpc_cidr}}",
          "ROKSBNKCTL_CLUSTER_VPC_ID": "{{inputs.cluster_vpc_id}}",
          "ROKSBNKCTL_EXISTING_SUBNET_IDS": "{{inputs.existing_subnet_ids}}"
        },
        "args": [
          "roksbnkctl",
          "init",
          "-w",
          "bnk",
          "--override-from-env",
          "--non-interactive"
        ],
        "timeout_seconds": 300
      },
      {
        "name": "bnkforge-unregister",
        "when": "{{inputs.bnkforge_url}}",
        "env": {
          "HOME": "/home/runner",
          "ROKSBNKCTL_PREFIX": "{{inputs.prefix}}",
          "ROKSBNKCTL_REGION": "{{inputs.region}}",
          "ROKSBNKCTL_RESOURCE_GROUP": "{{inputs.resource_group}}",
          "ROKSBNKCTL_CLUSTER_CREATE": "true",
          "ROKSBNKCTL_OPENSHIFT_VERSION": "{{inputs.openshift_version}}",
          "ROKSBNKCTL_WORKERS_PER_ZONE": "{{inputs.workers_per_zone}}",
          "ROKSBNKCTL_CLUSTER_PUBLIC_GATEWAY": "{{inputs.public_gateway}}",
          "BNK_FORGE_URL": "{{inputs.bnkforge_url}}",
          "BNK_FORGE_USER": "{{inputs.bnkforge_username}}",
          "BNK_FORGE_PASSWORD": "{{inputs.bnkforge_password}}",
          "IBMCLOUD_API_KEY": "{{inputs.ibmcloud_api_key}}"
        },
        "args": [
          "roksbnkctl",
          "-w",
          "bnk",
          "bnkforge",
          "unregister",
          "--project",
          "{{inputs.bnkforge_project}}",
          "--insecure={{inputs.bnkforge_insecure}}"
        ],
        "timeout_seconds": 600
      },
      {
        "name": "tgw-disconnect",
        "env": {
          "HOME": "/home/runner",
          "ROKSBNKCTL_PREFIX": "{{inputs.prefix}}",
          "ROKSBNKCTL_REGION": "{{inputs.region}}",
          "ROKSBNKCTL_RESOURCE_GROUP": "{{inputs.resource_group}}",
          "ROKSBNKCTL_CLUSTER_CREATE": "true",
          "ROKSBNKCTL_OPENSHIFT_VERSION": "{{inputs.openshift_version}}",
          "ROKSBNKCTL_WORKERS_PER_ZONE": "{{inputs.workers_per_zone}}",
          "ROKSBNKCTL_CLUSTER_PUBLIC_GATEWAY": "{{inputs.public_gateway}}",
          "BNK_FORGE_URL": "{{inputs.bnkforge_url}}",
          "BNK_FORGE_USER": "{{inputs.bnkforge_username}}",
          "BNK_FORGE_PASSWORD": "{{inputs.bnkforge_password}}",
          "IBMCLOUD_API_KEY": "{{inputs.ibmcloud_api_key}}"
        },
        "args": [
          "roksbnkctl",
          "-w",
          "bnk",
          "tgw",
          "disconnect",
          "--auto"
        ],
        "timeout_seconds": 900
      },
      {
        "name": "cluster-down",
        "env": {
          "HOME": "/home/runner",
          "ROKSBNKCTL_PREFIX": "{{inputs.prefix}}",
          "ROKSBNKCTL_REGION": "{{inputs.region}}",
          "ROKSBNKCTL_RESOURCE_GROUP": "{{inputs.resource_group}}",
          "ROKSBNKCTL_CLUSTER_CREATE": "true",
          "ROKSBNKCTL_OPENSHIFT_VERSION": "{{inputs.openshift_version}}",
          "ROKSBNKCTL_WORKERS_PER_ZONE": "{{inputs.workers_per_zone}}",
          "ROKSBNKCTL_CLUSTER_PUBLIC_GATEWAY": "{{inputs.public_gateway}}",
          "IBMCLOUD_API_KEY": "{{inputs.ibmcloud_api_key}}"
        },
        "args": [
          "roksbnkctl",
          "-w",
          "bnk",
          "cluster",
          "down",
          "--auto"
        ],
        "timeout_seconds": 5400
      }
    ]
  },
  "inputs": {
    "required": [
      {
        "name": "prefix",
        "type": "string",
        "source": "user",
        "label": "Resource prefix",
        "description": "Prefix for every IBM resource this creates. The cluster itself is named EXACTLY this: roksbnkctl names a new cluster after the prefix, so there is no separate cluster name to choose.",
        "order": 1
      },
      {
        "name": "region",
        "type": "string",
        "source": "user",
        "label": "IBM Cloud region",
        "order": 3,
        "description": "IBM Cloud region to create the cluster in. Inherits from the selected credential template."
      },
      {
        "name": "resource_group",
        "type": "string",
        "source": "user",
        "label": "Resource group",
        "order": 4,
        "description": "IBM Cloud resource group. Inherits from the selected credential template."
      }
    ],
    "optional": [
      {
        "name": "cluster_vpc_cidr",
        "type": "string",
        "source": "user",
        "default": "",
        "label": "Cluster VPC address block",
        "description": "Address block for the new cluster's VPC, split into three per-zone prefixes, so /18 is the smallest usable value. Blank leaves IBM Cloud's 'auto', which assigns EVERY VPC in a region the same three prefixes (10.241.0.0/18 and friends) — two such VPCs on one Transit Gateway overlap and the gateway silently blackholes one of them. Set a distinct block per cluster whenever clusters share a gateway. 10.241.0.0/16 reproduces the current auto values exactly.",
        "order": 9
      },
      {
        "name": "ibmcloud_api_key",
        "type": "string",
        "source": "user",
        "sensitive": true,
        "default": "",
        "description": "IBM Cloud API key. Filled from the project's credential template at creation and carried by the module, so the module keeps working even if the project's template is cleared later."
      },
      {
        "name": "existing_transit_gateway",
        "type": "string",
        "source": "user",
        "default": "",
        "label": "Existing Transit Gateway (name or id)",
        "description": "Adopt this Transit Gateway instead of creating one. Blank creates a new gateway named <prefix>-tgw. A DISCONNECTED cluster must share a gateway with the private mirror it pulls from, so it adopts the gateway the mirror already sits on; a connected cluster needs no such peer and gets its own.",
        "order": 8
      },
      {
        "name": "openshift_version",
        "type": "string",
        "source": "user",
        "default": "4.20",
        "label": "OpenShift version",
        "order": 5,
        "description": "OpenShift version for the new cluster."
      },
      {
        "name": "workers_per_zone",
        "type": "string",
        "source": "user",
        "default": "2",
        "label": "Workers per zone",
        "description": "Across three zones; 2 gives a 6-worker cluster.",
        "order": 6
      },
      {
        "name": "public_gateway",
        "type": "string",
        "source": "user",
        "default": "true",
        "label": "Worker Internet egress",
        "description": "false builds a DISCONNECTED cluster whose workers have no egress — images must come from a private mirror and licensing from an F5 License Proxy.",
        "order": 7
      },
      {
        "name": "bnkforge_url",
        "type": "string",
        "source": "user",
        "default": "",
        "label": "BNK Forge URL",
        "description": "Blank skips registration entirely.",
        "order": 8
      },
      {
        "name": "bnkforge_username",
        "type": "string",
        "source": "user",
        "default": "",
        "order": 9,
        "description": "BNK Forge username used to register the new cluster."
      },
      {
        "name": "bnkforge_password",
        "type": "string",
        "source": "user",
        "default": "",
        "sensitive": true,
        "order": 10,
        "description": "BNK Forge password used to register the new cluster."
      },
      {
        "name": "bnkforge_project",
        "type": "string",
        "source": "user",
        "default": "",
        "order": 11,
        "description": "BNK Forge project to register the new cluster into."
      },
      {
        "name": "bnkforge_insecure",
        "type": "string",
        "source": "user",
        "default": "false",
        "order": 12,
        "description": "Skip TLS verification when the Forge certificate is self-signed."
      },
      {
        "name": "cluster_vpc_id",
        "type": "string",
        "source": "user",
        "label": "Existing cluster VPC (id)",
        "description": "Place the new cluster in a VPC you already have, instead of creating one (roksbnkctl v1.43.0+). Blank creates the VPC, which is the default. Use this where address space is allocated centrally. Leave 'Existing cluster subnets' blank to have roksbnkctl create the three zone subnets inside the adopted VPC.",
        "order": 92,
        "default": ""
      },
      {
        "name": "existing_subnet_ids",
        "type": "string",
        "source": "user",
        "label": "Existing cluster subnets (ids, comma-separated)",
        "description": "Adopt pre-created subnets instead of letting roksbnkctl cut them inside the VPC (roksbnkctl v1.44.0+). Comma-separated subnet ids in ZONE ORDER, e.g. 0717-a,0717-b,0717-c. Requires 'Existing cluster VPC (id)' — roksbnkctl refuses a subnet adopted independently of the VPC that contains it. Blank creates the subnets, which is the default.",
        "order": 93,
        "default": ""
      }
    ]
  },
  "references": []
}